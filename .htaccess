RewriteEngine On

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
</IfModule>

# Prevent direct web access to packaged runtime templates and root configuration.
# PHP include/require operations are unaffected by these request rewrite rules.
RewriteRule ^private_data(?:/|$) - [F,L]
RewriteRule ^runtime(?:/|$) - [F,L]
RewriteRule ^(?:sentryiq_config\.php|auth_flow\.php|\.user\.ini)$ - [F,L]

# Block direct HTTP requests to source, test, documentation, CLI, and VCS directories.
# Apache normalizes encoded path characters before matching this per-directory rule.
# Legacy public routes below terminate their internal rewrite with [END], so their
# application targets are not reprocessed by this direct-request guard.
RewriteRule ^(app|bin|cloud|docs|tests|scripts|\.github|\.git)(/|$) - [F,L,NC]

# Keep existing deployed endpoint URLs working while implementations live under app/.
RewriteRule ^document_delete\.php$ app/Documents/Delete.php [END]
RewriteRule ^document_download\.php$ app/Documents/Download.php [END]
RewriteRule ^document_upload\.php$ app/Documents/Upload.php [END]

RewriteRule ^gallery_album\.php$ app/Gallery/AlbumActions.php [END]
RewriteRule ^gallery_bulk_delete\.php$ app/Gallery/BulkDelete.php [END]
RewriteRule ^gallery_delete\.php$ app/Gallery/Delete.php [END]
RewriteRule ^gallery_image\.php$ app/Gallery/Image.php [END]
RewriteRule ^gallery_settings\.php$ app/Gallery/Settings.php [END]
RewriteRule ^gallery_upload\.php$ app/Gallery/Upload.php [END]

RewriteRule ^passkey_auth\.php$ app/Auth/PasskeyAuth.php [END]
RewriteRule ^passkey_login\.php$ app/Auth/PasskeyLogin.php [END]
RewriteRule ^passkey_setup\.php$ app/Auth/PasskeySetup.php [END]
RewriteRule ^passkeys\.php$ app/Auth/Passkeys.php [END]

RewriteRule ^record_actions\.php$ app/Vault/RecordActions.php [END]
RewriteRule ^records_category_actions\.php$ app/Vault/RecordsCategoryActions.php [END]
RewriteRule ^records_view_data\.php$ app/Vault/RecordsViewData.php [END]
RewriteRule ^security-features\.php$ app/Security/SecurityFeatures.php [END]
RewriteRule ^security_log\.php$ app/Security/SecurityLog.php [END]
RewriteRule ^system_log\.php$ app/Security/SystemLog.php [END]
RewriteRule ^vault_actions\.php$ app/Vault/Actions.php [END]
RewriteRule ^vault_category_actions\.php$ app/Vault/CategoryActions.php [END]
RewriteRule ^vault_folder_data\.php$ app/Vault/FolderData.php [END]

# Preserve existing browser asset URLs after moving static files under assets/.
RewriteRule ^pm_style\.css$ assets/css/sentryiq.css [L]
RewriteRule ^vault_folders\.js$ assets/js/vault_folders.js [L]
RewriteRule ^records_view\.js$ assets/js/records_view.js [L]
RewriteRule ^safari\.js$ assets/js/safari.js [L]
RewriteRule ^sentryiq-logo-wide\.webp$ assets/images/sentryiq-logo-wide.webp [L]
RewriteRule ^assets/css/sentryiq-logo-wide\.webp$ assets/images/sentryiq-logo-wide.webp [L]
