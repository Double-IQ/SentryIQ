{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sentryiq-node-a-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "NODE_A_TARGETS",
      "bucket_name": "sentryiq-node-a-targets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NODE_A_STATE",
        "class_name": "NodeAState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NodeAState"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
