new file mode 100644
--- /dev/null
+++ b/packages/client/tests/storage-error.test.ts
@@ -0,0 +1,12 @@
+import { isTufStorageError } from '../src/updater';
+
+describe('durable TUF storage errors', () => {
+  it('classifies durable read and commit failures as non-recoverable', () => {
+    expect(isTufStorageError({ code: 'TUF_METADATA_READ_FAILED' })).toBe(true);
+    expect(isTufStorageError({ code: 'TUF_METADATA_COMMIT_FAILED' })).toBe(true);
+    expect(isTufStorageError(new Error('ordinary cache parse failure'))).toBe(
+      false
+    );
+    expect(isTufStorageError(null)).toBe(false);
+  });
+});
